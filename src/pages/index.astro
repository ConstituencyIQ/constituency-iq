---
import fs from 'node:fs';
import path from 'node:path';
import HeatmapCard from '../components/HeatmapCard.astro';
import { Analytics } from '@vercel/analytics/astro';

const publicDir = path.resolve('public');
let constituencies = [];

// Fallback coordinate mappings for key regions/towns if coordinates are missing from JSON
const regionCoordinates = {
  'South East': { lat: 51.24, lon: -0.21 }, // Centered near Surrey/Reigate
  'London': { lat: 51.50, lon: -0.12 },
  'North West': { lat: 53.48, lon: -2.24 },
  'Scotland': { lat: 56.49, lon: -4.20 },
  'Wales': { lat: 52.13, lon: -3.78 },
  'North East': { lat: 54.97, lon: -1.61 },
  'Yorkshire and the Humber': { lat: 53.95, lon: -1.08 },
  'West Midlands': { lat: 52.48, lon: -1.89 },
  'East Midlands': { lat: 52.95, lon: -1.15 },
  'East of England': { lat: 52.20, lon: 0.12 },
  'South West': { lat: 50.71, lon: -3.53 },
  'Northern Ireland': { lat: 54.60, lon: -6.69 }
};

try {
  if (fs.existsSync(publicDir)) {
    const files = fs.readdirSync(publicDir);
    const jsonFiles = files.filter(f => f.endsWith('.json'));
    
    constituencies = jsonFiles.map(file => {
      const filePath = path.join(publicDir, file);
      try {
        const content = fs.readFileSync(filePath, 'utf-8');
        const data = JSON.parse(content);
        const region = data.region || 'South East';
        
        // Use explicit coordinates if present, otherwise fallback to regional center
        const defaultCoords = regionCoordinates[region] || { lat: 51.5, lon: -0.1 };
        const lat = (data.center_lat && data.center_lat !== 54.5) ? data.center_lat : defaultCoords.lat;
        const lon = (data.center_lon && data.center_lon !== -3.5) ? data.center_lon : defaultCoords.lon;

        return {
          slug: file.replace('.json', ''),
          name: data.name || file.replace('.json', ''),
          region: region,
          mpName: data.mp?.name || 'Representative Unavailable',
          party: data.mp?.party || 'Independent',
          lat: lat,
          lon: lon
        };
      } catch (err) {
        return null;
      }
    }).filter(Boolean).sort((a, b) => a.name.localeCompare(b.name));
  }
} catch (e) {
  console.error("Error loading constituency files:", e);
}

const regionsMap = constituencies.reduce((acc, seat) => {
  if (!acc[seat.region]) acc[seat.region] = [];
  acc[seat.region].push(seat);
  return acc;
}, {});

const regionNames = Object.keys(regionsMap).sort();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UK Parliamentary Constituencies Hub</title>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <style>
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #f8fafc;
        color: #0f172a;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 1350px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
      }
      .preview-layout {
        display: grid;
        grid-template-columns: 440px 1fr;
        gap: 2rem;
        align-items: start;
      }
      @media (max-width: 1000px) {
        .preview-layout {
          grid-template-columns: 1fr;
        }
      }
      .left-column {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }
      .panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
      }
      .panel h1 {
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0.5rem 0 0.75rem 0;
        color: #0f172a;
      }
      .panel h2 {
        font-size: 1.3rem;
        font-weight: 800;
        margin: 0.3rem 0 0.5rem 0;
        color: #0f172a;
      }
      .panel p {
        color: #475569;
        line-height: 1.5;
        font-size: 0.88rem;
        margin-bottom: 1.25rem;
      }
      .badge-tag {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #4f46e5;
        background: #eef2ff;
        padding: 0.3rem 0.65rem;
        border-radius: 9999px;
        display: inline-block;
      }
      .search-tabs {
        display: flex;
        gap: 0.4rem;
        margin-bottom: 1rem;
      }
      .tab-btn {
        background: #f1f5f9;
        border: none;
        padding: 0.45rem 0.75rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.75rem;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s;
      }
      .tab-btn.active {
        background: #4f46e5;
        color: #ffffff;
      }
      .search-section {
        display: none;
        position: relative;
        text-align: left;
      }
      .search-section.active {
        display: block;
      }
      .search-box {
        width: 100%;
        padding: 0.75rem 0.9rem;
        border: 2px solid #cbd5e1;
        border-radius: 10px;
        font-size: 0.92rem;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s;
      }
      .search-box:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
      }
      .search-btn {
        margin-top: 0.65rem;
        width: 100%;
        background: #4f46e5;
        color: white;
        border: none;
        padding: 0.65rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.88rem;
        cursor: pointer;
        transition: background 0.2s;
      }
      .search-btn:hover {
        background: #4338ca;
      }
      .autocomplete-list {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: none;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
        max-height: 220px;
        overflow-y: auto;
        z-index: 50;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        display: none;
      }
      .autocomplete-item {
        padding: 0.65rem 0.9rem;
        cursor: pointer;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-decoration: none;
        color: #0f172a;
        font-size: 0.88rem;
      }
      .autocomplete-item:hover {
        background-color: #f8fafc;
        color: #4f46e5;
      }
      .item-region {
        font-size: 0.68rem;
        background: #f1f5f9;
        color: #64748b;
        padding: 0.15rem 0.4rem;
        border-radius: 9999px;
      }
      .error-msg {
        color: #dc2626;
        font-size: 0.82rem;
        margin-top: 0.4rem;
        display: none;
      }
      .regions-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.5rem;
        margin-top: 0.5rem;
      }
      .region-mini-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.4rem;
        border-radius: 8px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
      }
      .region-mini-card:hover {
        border-color: #4f46e5;
        background: #eef2ff;
        color: #4f46e5;
      }
      .region-name {
        font-size: 0.78rem;
        font-weight: 700;
        color: #1e293b;
      }
      .region-seats {
        font-size: 0.65rem;
        color: #64748b;
        margin-top: 0.1rem;
      }
      .right-panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
        display: flex;
        flex-direction: column;
      }
      #uk-map {
        height: 800px;
        width: 100%;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        margin-top: 0.75rem;
        z-index: 10;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="preview-layout">
        
        <!-- LEFT COLUMN -->
        <div class="left-column">
          
          <div class="panel">
            <span class="badge-tag">National Data Hub</span>
            <h1>UK Parliamentary Constituencies</h1>
            <p>
              Explore official Office for National Statistics (ONS) socioeconomic indicators, housing affordability metrics, and live Member of Parliament representation across all 650 UK seats.
            </p>

            <div class="search-tabs">
              <button id="tab-name-btn" class="tab-btn active" onclick="switchTab('name')">Constituency / MP Search</button>
              <button id="tab-postcode-btn" class="tab-btn" onclick="switchTab('postcode')">Postcode Finder</button>
            </div>
            
            <div id="section-name" class="search-section active">
              <input 
                type="text" 
                id="search-input" 
                placeholder="Search by constituency name, region, or MP..." 
                autocomplete="off"
                class="search-box"
              />
              <div id="autocomplete-results" class="autocomplete-list"></div>
            </div>

            <div id="section-postcode" class="search-section">
              <input 
                type="text" 
                id="postcode-input" 
                placeholder="Enter UK Postcode (e.g., SW1A 0AA)..." 
                autocomplete="off"
                class="search-box"
              />
              <button class="search-btn" onclick="lookupPostcode()">Find Constituency by Postcode</button>
              <div id="postcode-error" class="error-msg"></div>
            </div>
          </div>

          <div class="panel">
            <span class="badge-tag">Geographic Explorer</span>
            <h2>UK Regional Map & Nations</h2>
            <p>Select a region or nation to explore its constituencies:</p>
            
            <div class="regions-grid">
              {regionNames.map(region => (
                <div class="region-mini-card" onclick={`alert('Viewing region: ${region}')`}>
                  <div class="region-name">{region}</div>
                  <div class="region-seats">{regionsMap[region].length} seats</div>
                </div>
              ))}
            </div>
          </div>

          <!-- NEW HEATMAP CARD LINK PROPERLY NESTED INSIDE LEFT-COLUMN -->
          <HeatmapCard />

        </div>

        <!-- RIGHT COLUMN: Interactive Coordinate Map -->
        <div class="right-panel">
          <span class="badge-tag">Geographic Explorer</span>
          <h2>Interactive UK Map</h2>
          <p>Click any constituency marker to inspect its representative and open its profile.</p>
          
          <div id="uk-map"></div>
        </div>

      </div>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- Client-side Engine -->
    <script define:vars={{ constituencies }}>
      window.switchTab = function(mode) {
        ['name', 'postcode'].forEach(m => {
          document.getElementById(`tab-${m}-btn`).classList.remove('active');
          document.getElementById(`section-${m}`).classList.remove('active');
        });
        document.getElementById(`tab-${mode}-btn`).classList.add('active');
        document.getElementById(`section-${mode}`).classList.add('active');
      };

      // Initialize Leaflet map with preferred detailed zoom (Zoom 6) centered over the UK
      const map = L.map('uk-map').setView([54.5, -3.5], 6);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      const markersGroup = L.layerGroup().addTo(map);

      constituencies.forEach(seat => {
        if (seat.lat && seat.lon) {
          const marker = L.circleMarker([seat.lat, seat.lon], {
            radius: 5,
            fillColor: '#4f46e5',
            color: '#ffffff',
            weight: 1.5,
            opacity: 1,
            fillOpacity: 0.85
          });

          marker.bindPopup(`
            <div style="font-family: system-ui; padding: 2px;">
              <strong style="font-size: 0.95rem; color: #0f172a;">${seat.name}</strong><br/>
              <span style="font-size: 0.8rem; color: #475569;">MP: ${seat.mpName} (${seat.party})</span><br/>
              <a href="/${seat.slug}" style="display: inline-block; margin-top: 6px; font-size: 0.8rem; font-weight: 600; color: #4f46e5; text-decoration: none;">View Full Profile &rarr;</a>
            </div>
          `);

          marker.on('mouseover', function() {
            this.openPopup();
          });

          marker.on('click', function() {
            window.location.href = `/${seat.slug}`;
          });

          markersGroup.addLayer(marker);
        }
      });

      // Search Autocomplete Engine
      const searchInput = document.getElementById('search-input');
      const resultsContainer = document.getElementById('autocomplete-results');

      if (searchInput && resultsContainer) {
        searchInput.addEventListener('input', (e) => {
          const query = e.target.value.toLowerCase().trim();
          
          if (query.length < 2) {
            resultsContainer.style.display = 'none';
            resultsContainer.innerHTML = '';
            return;
          }

          const filtered = constituencies.filter(seat => 
            seat.name.toLowerCase().includes(query) || 
            seat.region.toLowerCase().includes(query) ||
            seat.mpName.toLowerCase().includes(query) ||
            seat.party.toLowerCase().includes(query)
          ).slice(0, 8);

          if (filtered.length > 0) {
            resultsContainer.innerHTML = filtered.map(seat => `
              <a href="/${seat.slug}" class="autocomplete-item">
                <div>
                  <strong>${seat.name}</strong>
                  <div style="font-size: 0.78rem; color: #64748b;">MP: ${seat.mpName} (${seat.party})</div>
                </div>
                <span class="item-region">${seat.region}</span>
              </a>
            `).join('');
            resultsContainer.style.display = 'block';
          } else {
            resultsContainer.innerHTML = `<div style="padding: 0.8rem; color: #64748b; text-align: center; font-size: 0.85rem;">No matching constituencies found</div>`;
            resultsContainer.style.display = 'block';
          }
        });

        document.addEventListener('click', (e) => {
          if (!searchInput.contains(e.target) && !resultsContainer.contains(e.target)) {
            resultsContainer.style.display = 'none';
          }
        });
      }

      window.lookupPostcode = async function() {
        const input = document.getElementById('postcode-input');
        const errDiv = document.getElementById('postcode-error');
        const pc = input.value.trim();

        errDiv.style.display = 'none';
        errDiv.textContent = '';

        if (!pc) {
          errDiv.textContent = 'Please enter a valid UK postcode.';
          errDiv.style.display = 'block';
          return;
        }

        try {
          const res = await fetch(`https://api.postcodes.io/postcodes/${encodeURIComponent(pc)}`);
          const data = await res.json();

          if (data.status === 200 && data.result && data.result.parliamentary_constituency) {
            const seatName = data.result.parliamentary_constituency;
            const matchedSeat = constituencies.find(s => s.name.toLowerCase() === seatName.toLowerCase());
            const slug = matchedSeat ? matchedSeat.slug : seatName.toLowerCase()
              .replace(/ & /g, '-and-')
              .replace(/\s+/g, '-')
              .replace(/'/g, '')
              .replace(/\./g, '');
            
            window.location.href = `/${slug}`;
          } else {
            errDiv.textContent = 'Postcode not found or parliamentary constituency unavailable.';
            errDiv.style.display = 'block';
          }
        } catch (err) {
          errDiv.textContent = 'Error connecting to postcode service. Please try again.';
          errDiv.style.display = 'block';
        }
      };
    </script>

    <!-- Vercel Web Analytics Tracker -->
    <Analytics />
  </body>
</html>