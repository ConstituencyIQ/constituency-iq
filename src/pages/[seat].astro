---
import '../styles/global.css';

// Explicitly define our generated seats so routing is 100% reliable
export function getStaticPaths() {
  const seats = [
    { slug: 'reigate' },
    { slug: 'dorking-horley' },
    { slug: 'cities-of-london-and-westminster' },
    { slug: 'birmingham-edgbaston' },
    { slug: 'manchester-central' }
  ];

  return seats.map((seat) => {
    return {
      params: { seat: seat.slug },
    };
  });
}

// Read the seat parameter from the URL
const { seat } = Astro.params;

// Load the corresponding JSON file generated by your Python pipeline
let seatData;
try {
  seatData = await import(`../../public/${seat}.json`);
} catch (e) {
  seatData = null;
}

// Fallback if a seat isn't found
if (!seatData) {
  throw new Error(`Constituency data not found for: ${seat}`);
}

const { name, region, onsCode, electorate, metrics } = seatData;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{name} — UK Constituency Profile</title>
	</head>
	<body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen p-6 md:p-12">
		
		<main class="max-w-4xl mx-auto space-y-8">
			
			<!-- Navigation Breadcrumb -->
			<div>
				<a href="/" class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors">
					&larr; Back to Constituency Directory
				</a>
			</div>

			<!-- Constituency Hero Header -->
			<div class="bg-white border border-slate-200 rounded-xl p-6 md:p-8 shadow-sm">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
					<div>
						<div class="flex items-center gap-2">
							<span class="text-xs font-semibold tracking-wider text-indigo-600 uppercase">{region}</span>
							<span class="text-slate-300">&bull;</span>
							<span class="text-xs font-mono text-slate-500">GSS Code: {onsCode}</span>
						</div>
						<h1 class="text-3xl font-bold tracking-tight text-slate-900 mt-1">{name}</h1>
					</div>
					<div class="bg-slate-50 border border-slate-200 px-4 py-3 rounded-lg text-left md:text-right">
						<span class="block text-xs font-medium text-slate-500 uppercase tracking-wider">Registered Electorate</span>
						<span class="text-xl font-bold text-slate-900 font-mono">{electorate.toLocaleString()}</span>
					</div>
				</div>
			</div>

			<!-- Core Metrics Grid -->
			<div class="space-y-4">
				<h2 class="text-xl font-bold tracking-tight text-slate-800">Socioeconomic Indicators</h2>
				
				<div class="grid gap-4 md:grid-cols-2">
					
					<!-- Median Weekly Earnings -->
					<div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
						<span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Median Weekly Earnings</span>
						<div class="mt-2 flex items-baseline justify-between">
							<span class="text-2xl font-bold text-slate-900">{metrics.medianEarnings}</span>
							<span class="text-xs font-medium px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700">{metrics.earningsVariance}</span>
						</div>
						<p class="text-xs text-slate-500 mt-3">Gross weekly pay for full-time employee residents.</p>
					</div>

					<!-- Median House Price -->
					<div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
						<span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Median House Price</span>
						<div class="mt-2 flex items-baseline justify-between">
							<span class="text-2xl font-bold text-slate-900">{metrics.housePrice}</span>
							<span class="text-xs font-medium px-2.5 py-1 rounded-full bg-amber-50 text-amber-700">{metrics.housePriceVariance}</span>
						</div>
						<p class="text-xs text-slate-500 mt-3">Average residential property transaction value.</p>
					</div>

					<!-- Claimant Rate -->
					<div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
						<span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Claimant Count Rate</span>
						<div class="mt-2 flex items-baseline justify-between">
							<span class="text-2xl font-bold text-slate-900">{metrics.claimantRate}</span>
							<span class="text-xs font-medium px-2.5 py-1 rounded-full bg-blue-50 text-blue-700">{metrics.claimantVariance}</span>
						</div>
						<p class="text-xs text-slate-500 mt-3">Proportion of resident population claiming unemployment benefits.</p>
					</div>

					<!-- Crime Rate -->
					<div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
						<span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Recorded Crime Rate</span>
						<div class="mt-2 flex items-baseline justify-between">
							<span class="text-2xl font-bold text-slate-900">{metrics.crimeRate}</span>
							<span class="text-xs font-medium px-2.5 py-1 rounded-full bg-purple-50 text-purple-700">{metrics.crimeVariance}</span>
						</div>
						<p class="text-xs text-slate-500 mt-3">Annual reported offenses relative to local population.</p>
					</div>

				</div>
			</div>

			<!-- Editorial Note Footer -->
			<div class="bg-slate-100 border border-slate-200 rounded-xl p-6 text-xs text-slate-600 leading-relaxed">
				<strong class="text-slate-900">Data Methodology:</strong> All figures presented are compiled from official parliamentary research briefings, Office for National Statistics (ONS) regional releases, and localized administrative datasets. Variances are measured relative to the national UK baseline average.
			</div>

		</main>

	</body>
</html>